__id__          = "tomato_bom"
__name__        = "🍅 Tomato Bom"
__version__     = "1.0"
__author__      = "@oodze"
__description__ = "Throw tomatoes at anyone! **Tap** to launch · **Hold** for machine-gun · **Double-tap** to close."

# NOTE: do NOT import random/math/struct — they are .so C extensions that are
# not code-signed in unsigned builds and fail to dlopen on iOS.
import _ios_bridge as bridge
import threading
import time

# ── pure-Python LCG (no C deps) ────────────────────────────────────────────────
_rng = [0xA3B2C1D0]

def _rand():
    """Lehmer LCG — returns float in [0, 1)."""
    _rng[0] = (_rng[0] * 1664525 + 1013904223) & 0xFFFFFFFF
    return _rng[0] / 0x100000000

def _uniform(a, b):
    return a + _rand() * (b - a)

# ── runtime state ──────────────────────────────────────────────────────────────
_overlay_id   = None
_rapid_active = False

# ── helpers ────────────────────────────────────────────────────────────────────

def _screen_size():
    info = bridge.get_screen_info()
    return info.get("width", 390.0), info.get("height", 844.0)

def _throw_tomato(oid):
    w, h  = _screen_size()
    x0    = _uniform(w * 0.12, w * 0.88)
    y0    = h + 10
    vx    = _uniform(-150.0, 150.0)
    vy    = _uniform(-h * 0.95, -h * 0.65)
    size  = _uniform(46.0, 74.0)
    bridge.show_projectile(oid, "🍅", x0, y0, size, vx, vy, 1.5)

def _rapid_loop(oid):
    global _rapid_active
    while _rapid_active:
        bridge.run_on_main_thread(lambda o=oid: _throw_tomato(o))
        time.sleep(0.12)

# ── gesture handlers ───────────────────────────────────────────────────────────

def _on_single_tap(oid):
    _throw_tomato(oid)
    bridge.haptic_feedback("light")

def _on_double_tap(oid):
    global _overlay_id, _rapid_active
    _rapid_active = False
    bridge.dismiss_overlay(oid)
    _overlay_id = None

def _on_longpress(oid, started):
    global _rapid_active
    if started:
        _rapid_active = True
        t = threading.Thread(target=_rapid_loop, args=(oid,), daemon=True)
        t.start()
        bridge.haptic_feedback("heavy")
    else:
        _rapid_active = False

# ── activation ─────────────────────────────────────────────────────────────────

def _activate():
    global _overlay_id
    if _overlay_id is not None:
        return
    oid = bridge.create_overlay(0.0)
    _overlay_id = oid
    # Register double-tap first so single-tap requires it to fail
    bridge.add_tap_gesture(oid, 2, lambda o=oid: _on_double_tap(o))
    bridge.add_tap_gesture(oid, 1, lambda o=oid: _on_single_tap(o))
    bridge.add_longpress_gesture(oid, lambda s, o=oid: _on_longpress(o, s), 0.35)
    bridge.show_bulletin("🍅 Tomato Bom", "Tap · Hold for rapid fire · Double-tap to close")

# ── menu item handler ──────────────────────────────────────────────────────────

def _on_menu_tap(params):
    if params.get("plugin_id") == __id__ and params.get("item_id") == "open":
        bridge.run_on_main_thread(_activate)

# ── plugin lifecycle ───────────────────────────────────────────────────────────

def on_load(plugin):
    bridge.register_plugin_entry(__id__, "chatlist",     "open", "🍅 Tomato Bom")
    bridge.register_plugin_entry(__id__, "context_menu", "open", "🍅 Tomato Bom")
    bridge.add_tl_hook("plugin.menu_item_tapped", _on_menu_tap)

def on_unload(plugin):
    global _overlay_id, _rapid_active
    _rapid_active = False
    if _overlay_id is not None:
        bridge.dismiss_overlay(_overlay_id)
        _overlay_id = None
