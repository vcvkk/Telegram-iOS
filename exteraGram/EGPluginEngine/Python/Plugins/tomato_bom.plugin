__id__          = "tomato_bom"
__name__        = "🍅 Tomato Bom"
__version__     = "1.1"
__author__      = "@oodze"
__description__ = "Throw tomatoes at anyone! **Tap** to splat · **Hold** for machine-gun · **Double-tap** to close."

# NOTE: do NOT import random/math/struct — they are .so C extensions that are
# not code-signed in unsigned builds and fail to dlopen on iOS.
import _ios_bridge as bridge
import threading
import time
import os

# ── pure-Python LCG (no C deps) ────────────────────────────────────────────────
_rng = [0xA3B2C1D0]

def _rand():
    """Lehmer LCG — returns float in [0, 1)."""
    _rng[0] = (_rng[0] * 1664525 + 1013904223) & 0xFFFFFFFF
    return _rng[0] / 0x100000000

def _uniform(a, b):
    return a + _rand() * (b - a)

# ── settings ────────────────────────────────────────────────────────────────────
def _tomato_size():
    return float(bridge.get_plugin_setting(__id__, "tomato_size", 260.0))

def _sound_volume():
    return float(bridge.get_plugin_setting(__id__, "sound_volume", 0.7))

def _fire_interval():
    return float(bridge.get_plugin_setting(__id__, "fire_interval", 0.12))

# ── asset URLs (original Android sources) ──────────────────────────────────────
_GIF_URL   = "https://gitflic.ru/attachment/upload/272e5dd1-a12c-4339-b78e-4bd8c1e5e05b"
_SOUND_URL = "https://gitflic.ru/attachment/upload/ee0494f8-51f6-4e38-bae8-2c17c68b8d9e"

# ── runtime state ──────────────────────────────────────────────────────────────
_overlay_id    = None
_audio_id      = -1
_rapid_active  = False
_last_tap_time = 0.0
_current_x     = 0.0
_current_y     = 0.0
_last_sound_t  = 0.0
_touch_down    = False
_longpress_timer = None

# Cached asset paths (set after first successful download)
_gif_path   = None
_sound_path = None

# ── asset management ───────────────────────────────────────────────────────────

def _ensure_assets():
    """Download GIF and sound on first use. Returns True if GIF is ready."""
    global _gif_path, _sound_path
    data_dir = bridge.get_plugin_data_dir(__id__)
    _gif_path   = data_dir + "/splat.gif"
    _sound_path = data_dir + "/splat.mp3"
    if not os.path.exists(_gif_path):
        if not bridge.download_file(_GIF_URL, _gif_path):
            return False
    if not os.path.exists(_sound_path):
        bridge.download_file(_SOUND_URL, _sound_path)  # sound is optional
    return os.path.exists(_gif_path)

# ── helpers ────────────────────────────────────────────────────────────────────

def _play_sound():
    global _last_sound_t
    if _audio_id < 0:
        return
    now = time.time()
    if now - _last_sound_t < 0.05:  # 50ms minimum between plays
        return
    _last_sound_t = now
    bridge.play_audio(_audio_id, _sound_volume(), 1.0)

def _spawn_tomato(x, y):
    """Show splat GIF at (x, y). Called from main thread OR via run_on_main_thread."""
    if _overlay_id is None or not _gif_path or not os.path.exists(_gif_path):
        return
    bridge.show_splat(_overlay_id, _gif_path, x, y, _tomato_size())
    _play_sound()

def _rapid_loop():
    """Machine-gun loop: runs on a background thread."""
    global _rapid_active
    while _rapid_active:
        x = _current_x + _uniform(-100.0, 100.0)
        y = _current_y + _uniform(-100.0, 100.0)
        bridge.run_on_main_thread(lambda lx=x, ly=y: _spawn_tomato(lx, ly))
        time.sleep(_fire_interval())

# ── long-press timer ───────────────────────────────────────────────────────────

def _cancel_longpress():
    global _longpress_timer
    if _longpress_timer:
        _longpress_timer.cancel()
        _longpress_timer = None

def _on_longpress_fired():
    """Called from threading.Timer (background thread) after 0.35s hold."""
    global _rapid_active
    if _touch_down and not _rapid_active:
        _rapid_active = True
        bridge.haptic_feedback("heavy")
        threading.Thread(target=_rapid_loop, daemon=True).start()

# ── raw touch handler ──────────────────────────────────────────────────────────
# action: 0=down, 1=up/cancel, 2=move
# Called from ObjC EGOverlayContentView on main thread.

def _on_touch(action, x, y):
    global _last_tap_time, _current_x, _current_y
    global _rapid_active, _overlay_id, _touch_down, _longpress_timer

    if action == 0:  # DOWN
        _touch_down = True
        _current_x = x
        _current_y = y
        now = time.time()

        # Double-tap detection (< 0.3s since last tap)
        if now - _last_tap_time < 0.3:
            _rapid_active = False
            _cancel_longpress()
            oid = _overlay_id
            _overlay_id = None
            _last_tap_time = 0.0
            if oid is not None:
                bridge.dismiss_overlay(oid)
            return

        _last_tap_time = now

        # Splat at touch position immediately (we're already on main thread)
        _spawn_tomato(x, y)
        bridge.haptic_feedback("light")

        # Arm long-press timer (0.35s → machine-gun)
        _cancel_longpress()
        timer = threading.Timer(0.35, _on_longpress_fired)
        _longpress_timer = timer
        timer.start()

    elif action == 2:  # MOVE
        _current_x = x
        _current_y = y

    elif action == 1:  # UP / CANCEL
        _touch_down = False
        _cancel_longpress()
        if _rapid_active:
            _rapid_active = False
            bridge.haptic_feedback("medium")

# ── activation ─────────────────────────────────────────────────────────────────

def _activate():
    """Entry point: download assets then create overlay (called on main thread)."""
    global _overlay_id
    if _overlay_id is not None:
        return

    def _async_activate():
        global _overlay_id, _audio_id
        if not _ensure_assets():
            bridge.run_on_main_thread(lambda: bridge.show_bulletin(
                "🍅 Tomato Bom", "Failed to download assets. Check your connection."))
            return
        # Load audio once
        if _audio_id < 0 and _sound_path and os.path.exists(_sound_path):
            _audio_id = bridge.load_audio(_sound_path)
        bridge.run_on_main_thread(_create_overlay)

    threading.Thread(target=_async_activate, daemon=True).start()

def _create_overlay():
    """Create the full-screen touch overlay. Called on main thread."""
    global _overlay_id, _rapid_active, _last_tap_time, _touch_down
    if _overlay_id is not None:
        return
    _rapid_active  = False
    _last_tap_time = 0.0
    _touch_down    = False
    oid = bridge.create_overlay(0.0)
    _overlay_id = oid
    bridge.add_touch_handler(oid, _on_touch)
    bridge.show_bulletin("🍅 Tomato Bom", "Tap · Hold for rapid fire · Double-tap to close")

# ── menu item handler ──────────────────────────────────────────────────────────

def _on_menu_tap(params):
    if params.get("plugin_id") == __id__ and params.get("item_id") == "open":
        bridge.run_on_main_thread(_activate)

# ── plugin lifecycle ───────────────────────────────────────────────────────────

def on_load(plugin):
    bridge.register_plugin_entry(__id__, "chatlist",     "open", "🍅 Tomato Bom")
    bridge.register_plugin_entry(__id__, "context_menu", "open", "🍅 Tomato Bom")
    bridge.add_tl_hook("plugin.menu_item_tapped", _on_menu_tap)

def on_unload(plugin):
    global _overlay_id, _rapid_active, _audio_id
    _rapid_active = False
    _cancel_longpress()
    if _overlay_id is not None:
        bridge.dismiss_overlay(_overlay_id)
        _overlay_id = None
    _audio_id = -1
