__id__           = "quotecreate"
__name__         = "✏️ Quote"
__os__           = "ios"
__version__      = "8.0"
__author__       = "@oodze"
__description__  = "Pixel-perfect quote images from the message selection toolbar."

import _ios_bridge as bridge
import eg_widgets as w
import os
import time


def _data_path(filename):
    d = bridge.get_plugin_data_dir(__id__)
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, filename)


_sheet_handle = [None]


def _show_preview(composite_path, peer_id, first_msg_id):
    if not composite_path or not os.path.exists(composite_path):
        bridge.show_bulletin("✏️ Quote", "Не удалось создать изображение")
        return

    root = w.LinearLayout()
    root.setOrientation("vertical")
    root._spec["padding"] = [0, 0, 0, 16]
    root._spec["layout_params"] = {"width": -1, "height": -2, "weight": 0, "margins": [0, 0, 0, 0]}

    img_view = w.ImageView()
    img_view.setImagePath(composite_path)
    img_view._spec["layout_params"] = {"width": -1, "height": 320, "weight": 0, "margins": [0, 0, 0, 12]}
    root.addView(img_view)

    def _btn(title, action):
        btn = w.Button()
        btn.setText(title)
        btn._spec["text_size"] = 17
        btn._spec["typeface"] = "medium"
        btn._spec["text_color"] = "label"
        btn._spec["background_drawable"] = {
            "color": "secondarySystemFill",
            "corner_radius": 12.0,
            "stroke_width": 0.5,
            "stroke_color": "separator"
        }
        btn._spec["layout_params"] = {"width": -1, "height": 50, "weight": 0, "margins": [16, 5, 16, 5]}
        btn.setOnClickListener(
            lambda a=action: _handle_action(a, composite_path, peer_id, first_msg_id)
        )
        return btn

    root.addView(_btn("Как фото",    "send_photo"))
    root.addView(_btn("Как файл",    "send_file"))
    root.addView(_btn("Копировать",  "copy"))
    root.addView(_btn("В галерею",   "save"))
    root.addView(_btn("Поделиться",  "share"))

    _sheet_handle[0] = bridge.show_bottom_sheet({"view": root._spec})


def _handle_action(action, path, peer_id, reply_id):
    h = _sheet_handle[0]
    if h:
        bridge.dismiss_dialog(h)
        _sheet_handle[0] = None
    if action == "send_photo":
        bridge.send_photo(peer_id, path, reply_id)
    elif action == "send_file":
        bridge.send_file(peer_id, path, "quote.png", reply_id)
    elif action == "copy":
        bridge.copy_image_to_clipboard(path)
    elif action == "save":
        bridge.save_image_to_photos(path, lambda ok: (
            bridge.show_bulletin("✏️ Quote", "Не удалось сохранить") if not ok else None
        ))
    elif action == "share":
        bridge.show_share_sheet(path)


_AVATAR_PTS = 34


def _build_render_spec(peer_id, sorted_ids):
    """
    Build a render_image spec for the given message list.
    Uses get_message (BRIDGE_VERSION 15) to determine author/incoming per message,
    then attaches an avatar overlay on the last incoming message of each same-author run.
    Falls back to get_message_info if get_message is unavailable (BRIDGE_VERSION < 15).
    """
    get_msg = getattr(bridge, "get_message", None)
    infos = {}
    for mid in sorted_ids:
        if get_msg:
            info = get_msg(peer_id, mid) or {}
        else:
            info = bridge.get_message_info(peer_id, mid) or {}
        infos[mid] = info

    items = []
    for i, mid in enumerate(sorted_ids):
        info = infos[mid]
        item = {"type": "message", "peer_id": peer_id, "msg_id": mid, "width": 390}

        # Attach avatar if this is the last incoming message in a same-author run
        if not info.get("is_outgoing"):
            aid = info.get("author_id")
            if aid:
                is_last_in_run = True
                if i + 1 < len(sorted_ids):
                    nxt = infos[sorted_ids[i + 1]]
                    if not nxt.get("is_outgoing") and nxt.get("author_id") == aid:
                        is_last_in_run = False
                if is_last_in_run:
                    item["avatar"] = {
                        "peer_id": aid,
                        "size": float(_AVATAR_PTS),
                        "anchor": "bottom_left",
                        "offset_x": 6.0,
                        "offset_y": 4.0,
                    }

        items.append(item)

    return {
        "layout": "vstack",
        "spacing": 2,
        "padding": 16,
        "background": {"type": "wallpaper", "fallback_color": "#1a1a1a"},
        "items": items,
    }


def _do_render_multiple(peer_id, message_ids):
    sorted_ids = sorted(message_ids)
    out = _data_path("quote_{}.png".format(int(time.time() * 1000)))

    # Use render_image (BRIDGE_VERSION 15) if available; otherwise fall back to v14 primitives.
    if hasattr(bridge, "render_image"):
        spec = _build_render_spec(peer_id, sorted_ids)
        def _on_render(path):
            bridge.run_on_main_thread(lambda: _show_preview(path, peer_id, sorted_ids[0]))
        bridge.render_image(spec, out, _on_render)
    else:
        _do_render_v14(peer_id, sorted_ids, out)


# ---------------------------------------------------------------------------
# Legacy v14 rendering path (kept as fallback when render_image unavailable)
# ---------------------------------------------------------------------------

def _do_render_v14(peer_id, sorted_ids, final_out):
    ts = int(time.time() * 1000)
    infos = {mid: (bridge.get_message_info(peer_id, mid) or {}) for mid in sorted_ids}
    bubbles = {}
    pending = [len(sorted_ids)]

    def _on_all_bubbles():
        ordered = [mid for mid in sorted_ids if bubbles.get(mid)]
        if not ordered:
            bridge.show_bulletin("✏️ Quote", "Не удалось создать изображение")
            return
        _draw_avatars_then_composite(peer_id, ordered, infos, bubbles, ts, final_out)

    for mid in sorted_ids:
        bub_out = _data_path("bubble_{}_{}.png".format(mid, ts))
        def _cb(path, mid=mid):
            bubbles[mid] = path
            pending[0] -= 1
            if pending[0] == 0:
                _on_all_bubbles()
        bridge.snapshot_message(peer_id, mid, bub_out, 390, _cb)


def _avatar_targets(ordered, infos):
    targets = []
    for i, mid in enumerate(ordered):
        info = infos.get(mid, {})
        if info.get("is_outgoing"):
            continue
        aid = info.get("author_id")
        if aid is None:
            continue
        last_in_run = True
        if i + 1 < len(ordered):
            nxt = infos.get(ordered[i + 1], {})
            if (not nxt.get("is_outgoing")) and nxt.get("author_id") == aid:
                last_in_run = False
        if last_in_run:
            targets.append((mid, aid))
    return targets


def _draw_avatars_then_composite(peer_id, ordered, infos, bubbles, ts, final_out):
    targets = _avatar_targets(ordered, infos)

    def _composite():
        wp_path = _data_path("wp_{}.png".format(ts))
        wp = bridge.get_wallpaper_image(wp_path)
        paths = [bubbles[mid] for mid in ordered]
        if len(paths) == 1 and not wp:
            composite = paths[0]
        else:
            composite = bridge.composite_images(paths, final_out, 2, 16, "#1a1a1a", wp or "")
        bridge.run_on_main_thread(lambda: _show_preview(composite, peer_id, ordered[0]))

    if not targets:
        _composite()
        return

    pending = [len(targets)]

    for mid, aid in targets:
        av_out = _data_path("avatar_{}_{}.png".format(mid, ts))
        def _acb(av_path, mid=mid):
            if av_path:
                av_size = bridge.get_image_size(av_path)
                bub_size = bridge.get_image_size(bubbles[mid])
                if av_size and bub_size:
                    scale = av_size[0] / float(_AVATAR_PTS)
                    x = int(6 * scale)
                    y = int(bub_size[1] - av_size[1] - 4 * scale)
                    over_out = _data_path("bubavatar_{}_{}.png".format(mid, ts))
                    res = bridge.overlay_image(bubbles[mid], av_path,
                                               x, y, av_size[0], av_size[1], over_out)
                    if res:
                        bubbles[mid] = res
            pending[0] -= 1
            if pending[0] == 0:
                _composite()
        bridge.get_peer_avatar(aid, av_out, _AVATAR_PTS, _acb)


def _on_selection_tap(params):
    peer_id     = params.get("peer_id", 0)
    message_ids = params.get("message_ids", [])
    if not peer_id or not message_ids:
        bridge.show_bulletin("✏️ Quote", "Нет данных сообщений")
        return
    bridge.run_on_main_thread(lambda: _do_render_multiple(peer_id, message_ids))


def on_load(plugin):
    bridge.add_tl_hook("plugin.selection_action_tapped", _on_selection_tap)
    bridge.log(__id__, "on_load complete (v8 — render_image/get_message; v14 fallback)")


def on_unload(plugin):
    bridge.log(__id__, "on_unload complete")
