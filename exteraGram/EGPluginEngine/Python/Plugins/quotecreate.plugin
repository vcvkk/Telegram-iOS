__id__           = "quotecreate"
__name__         = "✏️ Quote"
__os__           = "ios"
__version__      = "2.0"
__author__       = "@oodze"
__description__  = "Pixel-perfect quote images from messages. Tap · Send as photo/file · Copy · Save · Share."

import os
import time

_overlay_id = None
_pending_peer_id = 0
_pending_msg_id  = 0


def _data_path(filename):
    d = bridge.get_plugin_data_dir(__id__)
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, filename)


def _show_preview(image_path, peer_id, message_id):
    global _overlay_id, _pending_peer_id, _pending_msg_id

    if not image_path or not os.path.exists(image_path):
        bridge.show_bulletin("✏️ Quote", "Не удалось создать изображение")
        return

    _pending_peer_id = peer_id
    _pending_msg_id  = message_id

    screen = bridge.get_screen_info()
    scale  = screen.get("scale", 2.0) or 2.0
    W = screen.get("width",  390) / scale
    H = screen.get("height", 844) / scale

    oid = bridge.create_overlay(0.82)
    _overlay_id = oid

    # Read image size without PIL — decode a minimal PNG header
    iw, ih = _png_size(image_path)
    if iw <= 0 or ih <= 0:
        iw, ih = 300, 200

    margin = 20
    max_w = W - margin * 2
    max_h = H * 0.60
    s  = min(max_w / iw, max_h / ih, 1.0)
    dw = int(iw * s)
    x  = (W - dw) / 2
    y  = H * 0.07

    bridge.add_image_view(oid, image_path, x, y, dw, 1)

    def on_action(idx, label):
        global _overlay_id
        bridge.dismiss_overlay(oid)
        _overlay_id = None

        if label == "Как фото":
            bridge.send_photo(_pending_peer_id, image_path, _pending_msg_id)
        elif label == "Как файл":
            bridge.send_file(_pending_peer_id, image_path, "quote.png", _pending_msg_id)
        elif label == "Копировать":
            bridge.copy_image_to_clipboard(image_path)
            bridge.show_bulletin("✏️ Quote", "Скопировано")
        elif label == "В галерею":
            def _cb(ok):
                bridge.run_on_main_thread(lambda: bridge.show_bulletin(
                    "✏️ Quote", "Сохранено" if ok else "Ошибка сохранения"))
            bridge.save_image_to_photos(image_path, _cb)
        elif label == "Поделиться":
            bridge.show_share_sheet(image_path)
        # "Отмена" — overlay already dismissed

    bridge.show_action_sheet(
        "✏️ Цитата", "",
        ["Как фото", "Как файл", "Копировать", "В галерею", "Поделиться", "Отмена"],
        on_action
    )


def _png_size(path):
    """Read width/height from a PNG file without PIL (bytes 16-23 of IHDR chunk)."""
    try:
        with open(path, "rb") as f:
            header = f.read(24)
        if len(header) >= 24 and header[:8] == b'\x89PNG\r\n\x1a\n':
            import struct
            w, h = struct.unpack(">II", header[16:24])
            return w, h
    except Exception:
        pass
    return 0, 0


def _do_render(peer_id, msg_id):
    out_path = _data_path("quote_{}.png".format(int(time.time() * 1000)))

    def on_main():
        # Live path: message node is already in the list hierarchy
        view_ptr = bridge.find_message_view(peer_id, msg_id)
        if view_ptr:
            path = bridge.snapshot_view(view_ptr, out_path, 0)
            _show_preview(path, peer_id, msg_id)
        else:
            # Off-screen / async path
            def _cb(path):
                bridge.run_on_main_thread(lambda: _show_preview(path, peer_id, msg_id))
            bridge.snapshot_message(peer_id, msg_id, out_path, 0, _cb)

    bridge.run_on_main_thread(on_main)


def _on_menu_tap(params):
    if params.get("entry_type") != "context_menu" or params.get("item_id") != "quote":
        return

    peer_id    = params.get("peer_id", 0)
    message_id = params.get("message_id", 0)

    if not peer_id or not message_id:
        bridge.show_bulletin("✏️ Quote", "Нет данных сообщения")
        return

    _do_render(peer_id, message_id)


def on_load(plugin):
    bridge.register_plugin_entry(__id__, "context_menu", "quote", "✏️ Цитата")
    bridge.add_tl_hook("plugin.menu_item_tapped", _on_menu_tap)
    bridge.log(__id__, "on_load complete (v2 — pixel-perfect)")


def on_unload(plugin):
    global _overlay_id
    if _overlay_id is not None:
        try:
            bridge.dismiss_overlay(_overlay_id)
        except Exception:
            pass
        _overlay_id = None
    bridge.log(__id__, "on_unload complete")
